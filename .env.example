# ──────────────────────────────────────────────────────────────────────────
# Frontend (safe to expose to the browser — these are public by design)
# Copy this file to `.env.local` and fill in your Supabase project values.
# ──────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (Phase 3 — set via `supabase secrets set`,
# NEVER prefix with VITE_ and NEVER expose to the browser).
# ──────────────────────────────────────────────────────────────────────────
# SQUARE_ACCESS_TOKEN=
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
