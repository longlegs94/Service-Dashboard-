# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development, and add
# the same variables in Vercel → Project → Settings → Environment
# Variables for production. Every feature degrades gracefully if
# its key is missing — the site never crashes.
# ──────────────────────────────────────────────────────────────

# AI diagnosis chat — create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — Project Settings → API. The URL is public; the
# service-role key is SECRET (server-only, never expose client-side).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Booking email notifications — create a free key at https://resend.com
RESEND_API_KEY=
# Where booking notifications get sent (your business inbox)
BOOKING_NOTIFICATION_EMAIL=
